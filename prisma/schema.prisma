// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id          String   @id @default(uuid())
  email       String   @unique
  passwordHash String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("admins")
}

model ApiKey {
  id          String   @id @default(uuid())
  keyHash     String   @unique
  name        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastUsedAt  DateTime?

  @@map("api_keys")
}

model AnalyticsEvent {
  id          String   @id @default(uuid())
  uid         String?
  sessionId   String
  datetime    DateTime
  eventType   String   // 'pageview' | 'custom' | 'server_request'
  eventData   Json     // Store the event-specific data as JSON
  createdAt   DateTime @default(now())

  @@index([sessionId])
  @@index([uid])
  @@index([datetime])
  @@map("analytics_events")
}
